{
  "name": "moments",
  "private": true,
  "version": "0.1.0",
  "description": "Frictionless YouTube timestamp bookmarks: a Chrome extension + web UI backed by Supabase.",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/extension",
    "packages/web",
    "packages/downloader"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @moments/web",
    "dev:web": "npm run dev --workspace @moments/web",
    "dev:ext": "npm run dev --workspace @moments/extension",
    "dev:downloader": "npm run start --workspace @moments/downloader",
    "build": "npm run build --workspace @moments/web && npm run build --workspace @moments/extension",
    "build:web": "npm run build --workspace @moments/web",
    "build:ext": "npm run build --workspace @moments/extension",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "clean": "rm -rf packages/*/dist packages/*/node_modules node_modules",
    "deploy": "gh-pages -d packages/web/dist"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "gh-pages": "^6.3.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
