# cp packages/extension/.env.example packages/extension/.env.local
#
# These are inlined at build time, so re-run `npm run build:ext` after editing,
# then hit the reload icon on chrome://extensions.

# Supabase dashboard -> Project Settings -> API (anon key only).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Where the web UI lives — the toast's "All moments" button and the popup's
# "Open my moments" button point here.
VITE_WEB_APP_URL=http://localhost:5173
